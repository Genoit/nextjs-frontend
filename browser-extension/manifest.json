{
  "manifest_version": 3,
  "name": "Send to TrendED",
  "version": "0.2.0",
  "description": "Import the product page you are viewing into TrendED, through your own browser.",
  "action": {
    "default_title": "Send this product to TrendED"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://www.facebook.com/ads/library/*",
    "https://*.fbcdn.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-trended@trended.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}

{
  "manifest_version": 3,
  "name": "Send to TrendED",
  "version": "0.1.0",
  "description": "Import the product page you are viewing into TrendED, through your own browser.",
  "action": { "default_title": "Send this product to TrendED" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3001/*"]
}
